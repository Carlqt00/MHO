# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# DO NOT add service_role key or DATABASE_URL here — never commit those

# iTextMo SMS gateway — LOCAL probing only (Edge Functions read these from
# `supabase secrets`, not from .env). Get the key from the gateway phone:
# iTextMo app > Settings > Authentication > Password. Never commit real values.
ITEXTMO_BACKEND_URL=https://itextmo-backend-dev.vercel.app
ITEXTMO_USERNAME=dev_xxxxxxxx
ITEXTMO_PASSWORD=sk_live_xxxxxxxx
